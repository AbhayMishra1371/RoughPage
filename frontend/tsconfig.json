{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/lib/geometry": ["./lib/renderer/geometry"],
      "@/lib/latex": ["./lib/renderer/latex"],
      "@/lib/paginate": ["./lib/renderer/paginate"],
      "@/lib/rng": ["./lib/renderer/rng"],
      "@/lib/roughShapes": ["./lib/renderer/roughShapes"],
      "@/lib/handwriting": ["./lib/renderer/handwriting"],
      "@/lib/graphLayout": ["./lib/renderer/graphLayout"],
      "@/lib/useBoxSize": ["./lib/renderer/useBoxSize"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
